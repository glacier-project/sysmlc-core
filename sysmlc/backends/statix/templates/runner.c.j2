{% macro trace_fmt() -%}
{% for f in trace_fields %} ctx.{{ f.path }}={{ f.fmt }}{% endfor %}
{%- endmacro %}
{% macro trace_args() -%}
{% for f in trace_fields %}, {{ f.cast }}ctx.{{ f.path }}{% endfor %}
{%- endmacro %}
{{ banner }}
#include "{{ pkg_dir }}/{{ stem }}.h"

#include <stdio.h>
#include <string.h>
{% if has_timer %}
#include <stdlib.h>
{% endif %}

static bool {{ prefix }}_event_from_name(const char *name, sc_event_id_t *event_id)
{
    if ((name == NULL) || (event_id == NULL)) {
        return false;
    }
{% for e in events %}
    if (strcmp(name, "{{ e.name }}") == 0) {
        *event_id = {{ e.const }};
        return true;
    }
{% endfor %}
    return false;
}

static void {{ prefix }}_print_configuration(const {{ prefix }}_t *sm)
{
    sc_state_id_t count = {{ prefix }}_active_count(sm);
    sc_state_id_t i;
    (void)printf(" configuration=");
    for (i = 0; i < count; ++i) {
        if (i > 0) {
            (void)printf(",");
        }
        (void)printf("%s", {{ prefix }}_state_name({{ prefix }}_active_state(sm, i)));
    }
}
{% if has_timer %}

static bool {{ prefix }}_parse_tick(const char *arg, sc_time_t *out_tick)
{
    unsigned long parsed;
    char *end = NULL;
    if ((arg == NULL) || (out_tick == NULL) || (strncmp(arg, "tick:", 5) != 0)) {
        return false;
    }
    if ((arg[5] == '\0') || (arg[5] == '-')) {
        /* Reject "tick:" with no digits, and a negative value outright --
         * strtoul's own negative-wraparound handling would otherwise be the
         * only thing standing between a typo'd test input and a huge tick. */
        return false;
    }
    parsed = strtoul(arg + 5, &end, 10);
    if ((end == NULL) || (*end != '\0')) {
        return false;
    }
    if (parsed > (unsigned long)SC_TIME_MAX) {
        /* Reject out-of-range explicitly rather than truncating a huge
         * unsigned long down to sc_time_t, which would silently alias to
         * some other, smaller tick value. */
        return false;
    }
    *out_tick = (sc_time_t)parsed;
    return true;
}

static bool {{ prefix }}_parse_advance(const char *arg, unsigned long *out_count)
{
    unsigned long parsed;
    char *end = NULL;
    if ((arg == NULL) || (out_count == NULL) || (strncmp(arg, "advance:", 8) != 0)) {
        return false;
    }
    if ((arg[8] == '\0') || (arg[8] == '-')) {
        /* Reject "advance:" with no digits, and a negative value outright,
         * for the same reason _parse_tick rejects them. */
        return false;
    }
    parsed = strtoul(arg + 8, &end, 10);
    if ((end == NULL) || (*end != '\0')) {
        return false;
    }
    *out_count = parsed;
    return true;
}
{% endif %}

int main(int argc, char **argv)
{
    {{ prefix }}_context_t ctx;
    {{ prefix }}_t sm;
    sc_status_t status;
    int i;
{% if has_timer %}
    sc_time_t current_tick = 0u;
{% endif %}

    {{ prefix }}_context_init(&ctx);
    status = {{ prefix }}_init(&sm, &ctx);
    (void)printf("init status=%s state=%s final=%d{{ trace_fmt() }}", sc_status_str(status),
                 {{ prefix }}_state_name({{ prefix }}_get_state(&sm)), (int){{ prefix }}_is_final(&sm){{ trace_args() }});
    {{ prefix }}_print_configuration(&sm);
    (void)printf("\n");
    if (status != SC_STATUS_OK) {
        return 1;
    }

    for (i = 1; i < argc; ++i) {
        sc_event_id_t event_id = SC_EVENT_INVALID;
{% if has_timer %}
        sc_time_t tick_value;
        unsigned long advance_count;
        if ({{ prefix }}_parse_tick(argv[i], &tick_value)) {
            current_tick = tick_value;
            status = {{ prefix }}_tick(&sm, current_tick);
            (void)printf("tick %lu status=%s state=%s final=%d{{ trace_fmt() }}",
                         (unsigned long)current_tick, sc_status_str(status),
                         {{ prefix }}_state_name({{ prefix }}_get_state(&sm)), (int){{ prefix }}_is_final(&sm){{ trace_args() }});
            {{ prefix }}_print_configuration(&sm);
            (void)printf("\n");
            if ((status != SC_STATUS_OK) && (status != SC_STATUS_NO_TRANSITION)) {
                return 1;
            }
            continue;
        }
        if ({{ prefix }}_parse_advance(argv[i], &advance_count)) {
            unsigned long step;
            for (step = 0u; step < advance_count; ++step) {
                if (current_tick > (sc_time_t)(SC_TIME_MAX - (sc_time_t)SC_TICKS_PER_SECOND)) {
                    (void)fprintf(stderr, "advance: tick value would exceed SC_TIME_MAX\n");
                    return 1;
                }
                current_tick = (sc_time_t)(current_tick + (sc_time_t)SC_TICKS_PER_SECOND);
                status = {{ prefix }}_tick(&sm, current_tick);
                (void)printf("advance %lu status=%s state=%s final=%d{{ trace_fmt() }}",
                             (unsigned long)current_tick, sc_status_str(status),
                             {{ prefix }}_state_name({{ prefix }}_get_state(&sm)), (int){{ prefix }}_is_final(&sm){{ trace_args() }});
                {{ prefix }}_print_configuration(&sm);
                (void)printf("\n");
                if ((status != SC_STATUS_OK) && (status != SC_STATUS_NO_TRANSITION)) {
                    return 1;
                }
            }
            continue;
        }
{% endif %}
        if (!{{ prefix }}_event_from_name(argv[i], &event_id)) {
            (void)fprintf(stderr, "unknown event: %s\n", argv[i]);
            return 2;
        }
        status = {{ prefix }}_post(&sm, event_id);
        (void)printf("event %s status=%s state=%s final=%d{{ trace_fmt() }}", argv[i],
                     sc_status_str(status), {{ prefix }}_state_name({{ prefix }}_get_state(&sm)), (int){{ prefix }}_is_final(&sm){{ trace_args() }});
        {{ prefix }}_print_configuration(&sm);
        (void)printf("\n");
        if ((status != SC_STATUS_OK) && (status != SC_STATUS_NO_TRANSITION)) {
            return 1;
        }
    }
    return 0;
}
