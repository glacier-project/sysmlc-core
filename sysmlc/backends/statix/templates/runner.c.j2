{{ banner }}
#include "{{ pkg_dir }}/{{ stem }}.h"

#include <stdio.h>
#include <string.h>

static bool {{ prefix }}_event_from_name(const char *name, sc_event_id_t *event_id)
{
    if ((name == NULL) || (event_id == NULL)) {
        return false;
    }
{% for e in events %}
    if (strcmp(name, "{{ e.name }}") == 0) {
        *event_id = {{ e.const }};
        return true;
    }
{% endfor %}
    return false;
}

int main(int argc, char **argv)
{
    {{ prefix }}_context_t ctx;
    {{ prefix }}_t sm;
    sc_status_t status;
    int i;

    {{ prefix }}_context_init(&ctx);
    status = {{ prefix }}_init(&sm, &ctx);
    (void)printf("init status=%s state=%s final=%d\n", sc_status_str(status),
                 {{ prefix }}_state_name({{ prefix }}_get_state(&sm)), (int){{ prefix }}_is_final(&sm));
    if (status != SC_STATUS_OK) {
        return 1;
    }

    for (i = 1; i < argc; ++i) {
        sc_event_id_t event_id = SC_EVENT_INVALID;
        if (!{{ prefix }}_event_from_name(argv[i], &event_id)) {
            (void)fprintf(stderr, "unknown event: %s\n", argv[i]);
            return 2;
        }
        status = {{ prefix }}_post(&sm, event_id);
        (void)printf("event %s status=%s state=%s final=%d\n", argv[i],
                     sc_status_str(status), {{ prefix }}_state_name({{ prefix }}_get_state(&sm)), (int){{ prefix }}_is_final(&sm));
        if ((status != SC_STATUS_OK) && (status != SC_STATUS_NO_TRANSITION)) {
            return 1;
        }
    }
    return 0;
}
