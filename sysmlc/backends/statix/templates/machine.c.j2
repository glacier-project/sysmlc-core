{{ banner }}
#include "{{ pkg_dir }}/{{ stem }}.h"
{% if needs_math %}#include <math.h>
{% endif %}
{% if has_extern %}#include "statix_extern.h"
{% endif %}
{% if has_when %}
#if SC_MAX_WHEN_TRIGGERS < {{ when_count }}u
#error "SC_MAX_WHEN_TRIGGERS too small for this generated machine"
#endif
{% endif %}

#ifndef {{ prefix|upper }}_TRACE_MASK
#define {{ prefix|upper }}_TRACE_MASK SC_TRACE_MASK_ALL
#endif
#if (({{ prefix|upper }}_TRACE_MASK) & ~(SC_TRACE_MASK_ALL)) != 0u
#error "{{ prefix|upper }}_TRACE_MASK contains unsupported bits"
#endif
{% if has_timer %}
#define {{ prefix|upper }}_TRACE_AVAILABLE_MASK SC_TRACE_MASK_ALL
{% else %}
#define {{ prefix|upper }}_TRACE_AVAILABLE_MASK (SC_TRACE_MASK_ALL & ~SC_TRACE_MASK_TIMER_CHECK)
{% endif %}
#define SC_MACHINE_TRACE_MASK \
    (({{ prefix|upper }}_TRACE_MASK) & ({{ prefix|upper }}_TRACE_AVAILABLE_MASK))

#if SC_MACHINE_TRACE_MASK != 0u
#include <stdio.h>
#endif


/* Static state and transition tables (file-local). */
static const sc_state_def_t states[] = {
{% for r in state_rows %}
    {{ '{' }}{{ r.entry }}, {{ r.exit }}, {{ r.parent }}, {{ r.initial_child }}, {{ r.is_final }}, {{ r.slot }}, {{ r.region_first }}, {{ r.region_count }}{{ '}' }},
{% endfor %}
};

static const sc_state_id_t regions[] = {
{% for r in regions_rows %}
    {{ r }},
{% endfor %}
{% if not regions_rows %}
    SC_STATE_INVALID
{% endif %}
};

static const sc_transition_t transitions[] = {
{% for r in transition_rows %}
    {{ '{' }}{{ r.source }}, {{ r.event }}, {{ r.guard }}, {{ r.action }}, {{ r.target }}{{ '}' }},
{% endfor %}
{% if not transition_rows %}
    {{ '{' }}SC_STATE_INVALID, SC_EVENT_INVALID, SC_GUARD_NONE, SC_ACTION_NONE, SC_STATE_INVALID{{ '}' }}
{% endif %}
};

static const sc_invariant_t invariants[] = {
{% for r in invariant_rows %}
    {{ '{' }}{{ r.scope }}, {{ r.guard }}{{ '}' }},
{% endfor %}
{% if not invariant_rows %}
    {{ '{' }}SC_STATE_INVALID, SC_GUARD_NONE{{ '}' }}
{% endif %}
};

static const sc_machine_t machine_def = {
    transitions,
    states,
{% if transition_rows %}
    (uint16_t)(sizeof(transitions) / sizeof(transitions[0])),
{% else %}
    (uint16_t)0u,
{% endif %}
    {{ state_count_macro }},
    {{ initial_const }},
    (sc_state_id_t){{ max_depth }}u,
    invariants,
    (uint16_t){{ invariant_count }}u,
    regions,
    (sc_state_id_t){{ region_row_count }}u,
    (sc_state_id_t){{ prefix|upper }}_ACTIVE_CAPACITY,
};

/* Generated guard/action dispatch. */
static bool guard_eval(sc_guard_id_t guard_id, const sc_runtime_t *runtime, const sc_event_t *event)
{
{% if guards %}
{% if guards_use_ctx %}
    const {{ prefix }}_context_t *ctx = (const {{ prefix }}_context_t *)runtime->user_data;
{% else %}
    (void)runtime;
{% endif %}
    (void)event;
    switch (guard_id) {
{% for g in guards %}
    case {{ g.const }}:
        {
{% for line in g.preamble %}
            {{ line }}
{% endfor %}
            return {{ g.expr }};
        }
{% endfor %}
    default:
        return false;
    }
{% else %}
    (void)runtime;
    (void)event;
    (void)guard_id;
    return false;
{% endif %}
}

static sc_status_t action_exec(sc_action_id_t action_id, sc_runtime_t *runtime, const sc_event_t *event)
{
{% if actions %}
    {{ prefix }}_context_t *ctx = ({{ prefix }}_context_t *)runtime->user_data;
    (void)event;
    if (ctx == NULL) { return SC_STATUS_INVALID_ARGUMENT; }
    switch (action_id) {
{% for a in actions %}
    case {{ a.const }}:
{% for stmt in a.statements %}
        {{ stmt }}
{% endfor %}
        return SC_STATUS_OK;
{% endfor %}
    default:
        return SC_STATUS_ERROR;
    }
{% else %}
    (void)runtime;
    (void)event;
    (void)action_id;
    return SC_STATUS_OK;
{% endif %}
}
{% if has_timer %}

static bool timeout_due(sc_state_id_t state, const sc_runtime_t *runtime, sc_state_id_t activation_index)
{
{% if timeouts_use_ctx %}
    const {{ prefix }}_context_t *ctx = (const {{ prefix }}_context_t *)runtime->user_data;
{% endif %}
    switch (state) {
{% for r in timeout_rows %}
    case {{ r.state }}:
{% for line in r.lines %}
        {{ line }}
{% endfor %}
{% endfor %}
    default:
        return false;
    }
}
{% endif %}

void {{ prefix }}_context_init({{ prefix }}_context_t *ctx)
{
    if (ctx == NULL) {
        return;
    }
    *ctx = ({{ prefix }}_context_t){{ context_initializer }};
}

const char *{{ prefix }}_state_name(sc_state_id_t state)
{
    switch (state) {
{% for s in state_names %}
    case {{ s.const }}:
        return "{{ s.name }}";
{% endfor %}
    case SC_STATE_INVALID:
        return "SC_STATE_INVALID";
    default:
        return "SC_STATE_UNKNOWN";
    }
}

const char *{{ prefix }}_event_name(sc_event_id_t event)
{
    switch (event) {
{% for e in event_names %}
    case {{ e.const }}:
        return "{{ e.name }}";
{% endfor %}
    case SC_EVENT_COMPLETION:
        return "SC_EVENT_COMPLETION";
{% if has_timer %}
    case SC_EVENT_TIMEOUT:
        return "SC_EVENT_TIMEOUT";
{% endif %}
    case SC_EVENT_INVALID:
        return "SC_EVENT_INVALID";
    default:
        return "SC_EVENT_UNKNOWN";
    }
}

#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_GUARD)
static const char *guard_name(sc_guard_id_t guard)
{
    switch (guard) {
{% for g in guards %}
    case {{ g.const }}:
        return "{{ g.name }}";
{% endfor %}
    default:
        return "SC_GUARD_UNKNOWN";
    }
}
#endif

#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_TRANSITION)
static const char *action_name(sc_action_id_t action)
{
    switch (action) {
    case SC_ACTION_NONE:
        return "SC_ACTION_NONE";
{% for a in actions %}
    case {{ a.const }}:
        return "{{ a.name }}";
{% endfor %}
    default:
        return "SC_ACTION_UNKNOWN";
    }
}
#endif

#if SC_MACHINE_TRACE_MASK != 0u
static void trace_hook(sc_trace_kind_t kind, const sc_runtime_t *runtime,
                        const sc_event_t *event, const sc_trace_data_t *data)
{
    (void)runtime;
    (void)event;
    switch (kind) {
#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_ENTER)
    case SC_TRACE_ENTER:
        (void)printf("  trace: enter state=%s slot=%d\n",
                     {{ prefix }}_state_name(data->state), (int)data->activation_index);
        break;
#endif
#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_EXIT)
    case SC_TRACE_EXIT:
        (void)printf("  trace: exit state=%s slot=%d\n",
                     {{ prefix }}_state_name(data->state), (int)data->activation_index);
        break;
#endif
#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_TRANSITION)
    case SC_TRACE_TRANSITION:
        (void)printf("  trace: transition #%d %s -[%s]-> %s action=%s slot=%d\n",
                     (int)data->transition_index,
                     {{ prefix }}_state_name(data->source),
                     {{ prefix }}_event_name(event->id),
                     {{ prefix }}_state_name(data->target),
                     action_name(data->action),
                     (int)data->activation_index);
        break;
#endif
#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_GUARD)
    case SC_TRACE_GUARD:
        (void)printf("  trace: guard=%s state=%s result=%s\n",
                     guard_name(data->guard), {{ prefix }}_state_name(data->state),
                     data->result ? "true" : "false");
        break;
#endif
#if (SC_MACHINE_TRACE_MASK & SC_TRACE_MASK_TIMER_CHECK)
    case SC_TRACE_TIMER_CHECK:
        (void)printf("  trace: timer state=%s slot=%d due=%s\n",
                     {{ prefix }}_state_name(data->state),
                     (int)data->activation_index, data->result ? "true" : "false");
        break;
#endif
    default:
        break;
    }
}
#define SC_MACHINE_HAS_TRACE 1
#define SC_MACHINE_TRACE trace_hook
#endif

/* Instantiate the shared dispatch for this machine. */
#define SC_MACHINE_PREFIX {{ prefix }}
#define SC_MACHINE_DEF machine_def
#define SC_MACHINE_GUARD guard_eval
#define SC_MACHINE_ACTION action_exec
#define SC_MACHINE_ACTIVE_CAPACITY {{ prefix|upper }}_ACTIVE_CAPACITY
{% if has_send %}
#define SC_MACHINE_HAS_QUEUE 1
{% endif %}
{% if has_timer %}
#define SC_MACHINE_HAS_TIMER 1
#define SC_MACHINE_TIMEOUT_DUE timeout_due
{% endif %}
{% if has_when %}
#define SC_MACHINE_HAS_WHEN 1
{% endif %}
#include "sc/sc_machine.h"
#undef SC_MACHINE_TRACE_MASK
